{
  "name": "Channel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "server_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "voice"
      ],
      "default": "text"
    },
    "description": {
      "type": "string"
    },
    "participant_count": {
      "type": "number",
      "default": 0
    },
    "max_participants": {
      "type": "number",
      "default": 15
    }
  },
  "required": [
    "name",
    "server_id"
  ]
}
