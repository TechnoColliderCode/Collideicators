{
  "name": "Message",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "file"
      ],
      "default": "text"
    },
    "file_url": {
      "type": "string"
    }
  },
  "required": [
    "content",
    "sender_id",
    "sender_name"
  ]
}
